@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card blue-grey darken-1">
                <div class="card-content white-text">
                    <span class="card-title">My Goals</span>
                    <p>@(ViewBag.GoalsCount ?? 0) total</p>
                </div>
                <div class="card-action">
                    <a asp-controller="Goals" asp-action="Index" class="btn btn-light">Open</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card teal">
                <div class="card-content white-text">
                    <span class="card-title">Submit Feedback</span>
                    <p>Share feedback on your goals</p>
                </div>
                <div class="card-action">
                    <a asp-controller="Goals" asp-action="Index" class="btn btn-light">Go</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card indigo darken-1">
                <div class="card-content white-text">
                    <span class="card-title">KPIs</span>
                    <p>Track your metrics</p>
                </div>
                <div class="card-action">
                    <a asp-controller="Home" asp-action="Privacy" class="btn btn-light">View</a>
                </div>
            </div>
        </div>
    </div>
</div>
