@model IEnumerable<EmployeePerformance.Web.Models.Goal>
@{
    ViewData["Title"] = "My Goals";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mdc-typography--headline5">My Goals</h2>
        <a class="btn btn-primary" asp-action="Create">Add Goal</a>
    </div>

    <div class="row">
        @foreach (var g in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@g.Title</h5>
                        <p class="card-text text-muted">@g.Description</p>
                        <div class="d-flex justify-content-between">
                            <span class="badge bg-info">@g.Status</span>
                            @if (g.DueDate.HasValue)
                            {
                                <small class="text-muted">Due @g.DueDate.Value.ToShortDateString()</small>
                            }
                        </div>
                        <a asp-action="Details" asp-route-id="@g.Id" class="btn btn-outline-primary btn-sm mt-2">Open</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

